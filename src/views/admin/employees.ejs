<%- include("partials/header", { title: "Pracownicy" }) %>
<%- include("partials/sidebar") %>

<h1>Pracownicy</h1>

<form id="addEmployee">
  <select name="userId" required>
    <option value="">-- użytkownik --</option>
    <% users.forEach(u => { %>
      <option value="<%= u._id %>">
        <%= u.name %> <%= u.surname %> | <%= u.email %>
      </option>
    <% }) %>
  </select>

  <select name="role" required>
    <option value="Pracownik">Pracownik</option>
    <option value="Kierownik">Kierownik</option>
  </select>

  <button type="submit">Dodaj</button>
</form>

<hr/>

<ul>
  <% employees.forEach(e => { %>
    <li class="employee" data-id="<%= e._id %>">

      <b><%= e.user_id.name %> <%= e.user_id.surname %></b>
      (<%= e.user_id.email %>)

      <select class="role">
        <option value="Pracownik" <%= e.role === "Pracownik" ? "selected" : "" %>>
          Pracownik
        </option>
        <option value="Kierownik" <%= e.role === "Kierownik" ? "selected" : "" %>>
          Kierownik
        </option>
      </select>

      <button class="save">Zapisz</button>
      <button class="delete danger">Usuń</button>
      <span class="msg"></span>
    </li>
  <% }) %>
</ul>

<style>
ul { list-style: none; padding: 0; }
li { margin-bottom: 6px; }
select, button { margin-left: 4px; }
.danger {
  background: #c0392b;
  color: #fff;
  border: none;
  padding: 3px 6px;
}
.msg {
  margin-left: 6px;
  opacity: 0;
  transition: .2s;
  color: green;
}
.msg.show { opacity: 1; }
</style>

<script>
function showMsg(el, text) {
  const msg = el.querySelector(".msg");
  msg.innerText = text;
  msg.classList.add("show");
  setTimeout(() => {
    msg.classList.remove("show");
    msg.innerText = "";
  }, 1200);
}

document.getElementById("addEmployee").onsubmit = async e => {
  e.preventDefault();
  const f = e.target;

  const res = await fetch("/api/admin/employees", {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({
  user_id: f.userId.value,
  role: f.role.value
})
  });

  const data = await res.json();

  if (!res.ok) {
    alert(data.error || "Błąd dodawania pracownika");
    return;
  }

  location.reload();
};

document.querySelectorAll(".save").forEach(btn => {
  btn.onclick = async e => {
    const li = e.target.closest("li");
    const role = li.querySelector(".role").value;

    const res = await fetch(`/api/admin/employees/${li.dataset.id}`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ role })
    });

    const data = await res.json();

    if (!res.ok) {
      alert(data.error || "Błąd zapisu");
      return;
    }

    showMsg(li, "Zapisano");
  };
});

document.querySelectorAll(".delete").forEach(btn => {
  btn.onclick = async e => {
    const li = e.target.closest("li");

    await fetch(`/api/admin/employees/${li.dataset.id}`, {
      method: "DELETE"
    });

    li.remove();
  };
});
</script>

<%- include("partials/footer") %>
