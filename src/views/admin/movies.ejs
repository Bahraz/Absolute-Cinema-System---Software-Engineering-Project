<%- include("partials/header", { title: "Filmy" }) %> <%-
include("partials/sidebar") %>

<h1>Filmy</h1>

<hr />

<h2>Lista filmów</h2>

<ul id="moviesList">
  <% if (movies.length === 0) { %>
  <li>Brak filmów</li>
  <% } %> <% movies.forEach(m => { %>
  <li data-id="<%= m._id %>">
    <b><%= m.title %></b>
    (<%= m.release_year %>, <%= m.duration %> min) —
    <a href="/admin/movies/<%= m._id %>">Szczegóły</a>
    |
    <button class="delete danger">Usuń</button>
    <span class="msg"></span>
  </li>
  <% }) %>
</ul>

<hr />

<h2>Dodaj film</h2>

<form id="addMovie">
  <input name="title" placeholder="Tytuł" required /><br />
  <input name="release_year" type="number" placeholder="Rok" required /><br />
  <input
    name="duration"
    type="number"
    placeholder="Czas (min)"
    required
  /><br />
  <textarea name="description" placeholder="Opis" required></textarea><br />
  <button>Dodaj film</button>
</form>

<style>
  .danger {
    background: #c0392b;
    color: #fff;
    border: none;
    padding: 4px 8px;
    cursor: pointer;
  }
  .msg {
    margin-left: 6px;
    font-size: 0.85em;
    opacity: 0;
    transition: 0.2s;
  }
  .msg.show {
    opacity: 1;
    color: green;
  }
</style>

<script>
  document.getElementById("addMovie").onsubmit = async (e) => {
    e.preventDefault();
    const f = e.target;

    await fetch("/api/admin/movies", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        title: f.title.value,
        release_year: f.release_year.value,
        duration: f.duration.value,
        description: f.description.value,
      }),
    });

    location.reload();
  };

  document.querySelectorAll(".delete").forEach((btn) => {
    btn.onclick = async (e) => {
      const li = e.target.closest("li");
      const msg = li.querySelector(".msg");

      const res = await fetch(`/api/admin/movies/${li.dataset.id}`, {
        method: "DELETE",
      });

      if (!res.ok) {
        msg.innerText = "Błąd usuwania";
        msg.classList.add("show");
        return;
      }

      msg.innerText = "Usunięto";
      msg.classList.add("show");

      setTimeout(() => li.remove(), 400);
    };
  });
</script>

<%- include("partials/footer") %>
