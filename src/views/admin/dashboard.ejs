<%- include("partials/header", { title: "Panel Administratora" }) %> 
<%- include("partials/sidebar") %>

<main class="content-wrapper">
  <div class="admin-header">
    <h1>🚀 System Dashboard</h1>
    <p>Przegląd kluczowych wskaźników i nadchodzących wydarzeń.</p>
  </div>

  <div class="stats-grid">
    <div class="stat-card">
      <div class="stat-icon users">👤</div>
      <div class="stat-info">
        <span class="stat-label">Użytkownicy</span>
        <b class="stat-value" id="users">–</b>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon employees">👔</div>
      <div class="stat-info">
        <span class="stat-label">Pracownicy</span>
        <b class="stat-value" id="employees">–</b>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon movies">🎬</div>
      <div class="stat-info">
        <span class="stat-label">Filmy</span>
        <b class="stat-value" id="movies">–</b>
      </div>
    </div>

    <div class="stat-card">
      <div class="stat-icon screenings">📅</div>
      <div class="stat-info">
        <span class="stat-label">Seanse</span>
        <b class="stat-value" id="screenings">–</b>
      </div>
    </div>

    <div class="stat-card highlight">
      <div class="stat-icon reservations">🎟️</div>
      <div class="stat-info">
        <span class="stat-label">Rezerwacje</span>
        <b class="stat-value" id="reservations">–</b>
      </div>
    </div>
  </div>

  <div class="table-container">
    <div class="table-header">
      <h2>📅 Nadchodzące seanse</h2>
      <a href="/admin/screenings" class="btn-small">Zarządzaj seansami</a>
    </div>

    <table class="admin-table">
      <thead>
        <tr>
          <th>Tytuł Filmu</th>
          <th>Sala Kinowa</th>
          <th>Data i Godzina</th>
          <th align="right">Status</th>
        </tr>
      </thead>
      <tbody id="upcoming">
        <tr>
          <td colspan="4" class="loading">Inicjalizacja danych...</td>
        </tr>
      </tbody>
    </table>
  </div>
</main>

<style>
  :root {
    --accent-red: #e50914;
    --card-bg: #1f1f1f;
    --text-muted: #888;
    --border-subtle: #333;
  }

  .admin-header {
    margin-bottom: 40px;
  }

  .admin-header h1 {
    font-size: 2.2rem;
    margin: 0;
    font-weight: 800;
  }

  .admin-header p {
    color: var(--text-muted);
    margin-top: 5px;
  }

  /* SIATKA STATYSTYK */
  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: 20px;
    margin-bottom: 40px;
  }

  .stat-card {
    background: var(--card-bg);
    padding: 25px;
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    gap: 20px;
    transition: 0.3s;
  }

  .stat-card:hover {
    transform: translateY(-5px);
    border-color: var(--accent-red);
  }

  .stat-card.highlight {
    background: linear-gradient(145deg, #1f1f1f, #2a0507);
    border-color: rgba(229, 9, 20, 0.3);
  }

  .stat-icon {
    width: 50px;
    height: 50px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
  }

  .stat-label {
    display: block;
    color: var(--text-muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 1px;
  }

  .stat-value {
    font-size: 1.8rem;
    font-weight: 800;
    color: white;
  }

  /* TABELA */
  .table-container {
    background: var(--card-bg);
    border-radius: 12px;
    border: 1px solid var(--border-subtle);
    padding: 25px;
  }

  .table-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 20px;
  }

  .admin-table {
    width: 100%;
    border-collapse: collapse;
  }

  .admin-table th {
    text-align: left;
    color: var(--text-muted);
    font-size: 0.8rem;
    text-transform: uppercase;
    padding: 15px;
    border-bottom: 2px solid var(--border-subtle);
  }

  .admin-table td {
    padding: 15px;
    border-bottom: 1px solid var(--border-subtle);
    font-size: 0.95rem;
  }

  .admin-table tr:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .btn-small {
    background: var(--accent-red);
    color: white;
    text-decoration: none;
    font-size: 0.8rem;
    padding: 8px 15px;
    border-radius: 5px;
    font-weight: bold;
    transition: 0.2s;
  }

  .btn-small:hover {
    background: #ff0a16;
  }

  .loading {
    text-align: center;
    color: var(--text-muted);
    padding: 40px !important;
  }

  .badge-active {
    background: rgba(46, 125, 50, 0.2);
    color: #81c784;
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.75rem;
    font-weight: bold;
  }
</style>

<script>
  async function loadDashboard() {
    try {
      const res = await fetch("/api/admin/dashboard");
      const data = await res.json();

      document.getElementById("users").innerText = data.users;
      document.getElementById("employees").innerText = data.employees;
      document.getElementById("movies").innerText = data.movies;
      document.getElementById("screenings").innerText = data.screenings;
      document.getElementById("reservations").innerText = data.reservations;

      const tbody = document.getElementById("upcoming");
      tbody.innerHTML = "";

      if (data.upcomingScreenings.length === 0) {
        tbody.innerHTML = "<tr><td colspan='4' class='loading'>Brak nadchodzących seansów.</td></tr>";
        return;
      }

      data.upcomingScreenings.forEach((s) => {
        tbody.innerHTML += `
          <tr>
            <td><strong>${s.movie_id.title}</strong></td>
            <td>${s.hall_id.name}</td>
            <td>${new Date(s.start_at).toLocaleString('pl-PL', { 
              day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' 
            })}</td>
            <td align="right"><span class="badge-active">NADCHODZĄCY</span></td>
          </tr>
        `;
      });
    } catch (err) {
      console.error("Dashboard error:", err);
      document.getElementById("upcoming").innerHTML = "<tr><td colspan='4' style='color:red'>Błąd ładowania danych.</td></tr>";
    }
  }

  document.addEventListener("DOMContentLoaded", loadDashboard);
</script>

<%- include("partials/footer") %>