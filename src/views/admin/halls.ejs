<%- include("partials/header", { title: "Zarządzanie Salami" }) %> 
<%- include("partials/sidebar") %>

<div class="admin-container">
  <header class="section-header">
    <h1>🏛️ Sale Kinowe</h1>
    <p>Zarządzaj dostępnymi salami i konfiguruj ich układ miejsc.</p>
  </header>

  <section class="admin-card">
    <div class="card-title">Dodaj nową salę</div>
    <form id="addHall" class="inline-form">
      <div class="input-field">
        <input name="name" placeholder="Nazwa sali (np. Sala Gold, Sala IMAX)" required />
      </div>
      <button class="btn-primary">Stwórz salę</button>
      <span class="msg"></span>
    </form>
  </section>

  <section class="admin-card">
    <div class="card-title">Wszystkie sale w systemie</div>
    <table class="admin-table">
      <thead>
        <tr>
          <th>Nazwa Sali</th>
          <th align="right">Akcje</th>
        </tr>
      </thead>
      <tbody id="hallsList">
        <% if (halls.length === 0) { %>
          <tr><td colspan="2" class="empty-state">Brak zarejestrowanych sal.</td></tr>
        <% } %>
        <% halls.forEach(h => { %>
        <tr data-id="<%= h._id %>">
          <td><strong><%= h.name %></strong></td>
          <td align="right" class="table-actions">
            <a href="/admin/halls/<%= h._id %>" class="btn-icon setup" title="Konfiguruj miejsca">💺 Miejsca</a>
            <button class="btn-icon delete" title="Usuń salę">🗑️</button>
            <span class="msg"></span>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </section>
</div>

<style>
  :root {
    --accent-red: #e50914;
    --card-bg: #161616;
    --border: #333;
    --text-muted: #888;
  }

  .admin-container { max-width: 800px; margin: 0 auto; }
  .section-header { margin-bottom: 30px; }
  .section-header h1 { font-size: 2rem; margin: 0; }
  .section-header p { color: var(--text-muted); margin-top: 5px; }

  .admin-card { background: var(--card-bg); border: 1px solid var(--border); border-radius: 12px; padding: 25px; margin-bottom: 30px; }
  .card-title { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 1.5px; color: var(--text-muted); font-weight: 800; margin-bottom: 20px; }

  .inline-form { display: flex; gap: 15px; align-items: center; }
  .input-field { flex: 1; }
  input { width: 100%; padding: 12px; background: #222; border: 1px solid #444; border-radius: 6px; color: white; box-sizing: border-box; }
  input:focus { outline: none; border-color: var(--accent-red); }

  .admin-table { width: 100%; border-collapse: collapse; }
  .admin-table td { padding: 15px 12px; border-bottom: 1px solid var(--border); }
  .admin-table th { text-align: left; padding: 12px; color: var(--text-muted); font-size: 0.75rem; border-bottom: 2px solid var(--border); }

  .btn-primary { background: var(--accent-red); color: white; border: none; padding: 12px 25px; border-radius: 6px; font-weight: bold; cursor: pointer; transition: 0.2s; }
  .btn-primary:hover { background: #ff1a25; }

  .btn-icon { background: #2a2a2a; border: 1px solid #444; padding: 8px 15px; border-radius: 6px; cursor: pointer; text-decoration: none; color: white; font-size: 0.85rem; display: inline-flex; align-items: center; gap: 5px; }
  .btn-icon.delete:hover { background: #b71c1c; }
  .btn-icon.setup:hover { background: #2e7d32; }

  .msg { font-size: 0.75rem; margin-left: 10px; opacity: 0; transition: 0.3s; }
  .msg.show { opacity: 1; }
  .msg.error { color: #f44336; }
</style>

<script>
  document.getElementById("addHall").onsubmit = async (e) => {
    e.preventDefault();
    const f = e.target;
    const msg = f.querySelector(".msg");

    const res = await fetch("/api/admin/halls", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name: f.name.value }),
    });

    if (res.ok) {
      msg.innerText = "Dodano!";
      msg.classList.add("show");
      setTimeout(() => location.reload(), 400);
    } else {
      const data = await res.json();
      msg.innerText = data.error || "Błąd";
      msg.classList.add("show", "error");
    }
  };

  document.querySelectorAll(".delete").forEach((btn) => {
    btn.onclick = async (e) => {
      if(!confirm("Czy na pewno usunąć salę? Usunie to wszystkie przypisane miejsca i seanse!")) return;
      const tr = e.target.closest("tr");
      const res = await fetch(`/api/admin/halls/${tr.dataset.id}`, { method: "DELETE" });
      if (res.ok) tr.remove();
    };
  });
</script>

<%- include("partials/footer") %>