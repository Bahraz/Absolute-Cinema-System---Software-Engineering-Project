<h1>Zarządzaj Gatunkami</h1>

<!-- ===================== -->
<!-- DODAJ GATUNEK -->
<!-- ===================== -->
<section>
  <h2>Dodaj gatunek</h2>

  <form id="addGenreForm">
    <input name="name" type="text" placeholder="Nazwa gatunku..." required />
    <button type="submit">Dodaj gatunek</button>
  </form>
</section>

<script>
  document
    .getElementById("addGenreForm")
    .addEventListener("submit", async (e) => {
      e.preventDefault();

      const form = e.target;

      const res = await fetch("/api/genre/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: form.name.value,
        }),
      });

      if (res.ok) {
        window.location.href = "/genre/list";
      } else {
        const err = await res.json();
        alert(err.error || "Błąd dodawania gatunku");
      }
    });
</script>

<hr />

<!-- ===================== -->
<!-- EDYTUJ GATUNEK -->
<!-- ===================== -->
<section>
  <h2>Edytuj gatunek</h2>

  <form id="editGenreForm">
    <select id="editGenreSelect">
      <option value="">--- wybierz gatunek ---</option>

      <% genres.forEach(genre => { %>
      <option value="<%= genre.id %>" data-name="<%= genre.name %>">
        <%= genre.name %>
      </option>
      <% }) %>
    </select>

    <br /><br />

    <input name="name" type="text" placeholder="Nowa nazwa gatunku..." />

    <button type="submit">Zaktualizuj</button>
  </form>
</section>

<script>
  const editGenreSelect = document.getElementById("editGenreSelect");
  const editGenreForm = document.getElementById("editGenreForm");

  editGenreSelect.addEventListener("change", () => {
    const option = editGenreSelect.options[editGenreSelect.selectedIndex];

    if (!option.value) {
      editGenreForm.name.value = "";
      return;
    }

    editGenreForm.name.value = option.dataset.name || "";
  });

  editGenreForm.addEventListener("submit", async (e) => {
    e.preventDefault();

    const id = editGenreSelect.value;
    const name = editGenreForm.name.value.trim();

    if (!id || !name) {
      alert("Wybierz gatunek i podaj nazwę");
      return;
    }

    const res = await fetch(`/api/genre/update/${id}`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ name }),
    });

    if (res.ok) {
      window.location.href = "/genre/list";
    } else {
      const err = await res.json();
      alert(err.error || "Błąd edycji gatunku");
    }
  });
</script>

<hr />

<!-- ===================== -->
<!-- USUŃ GATUNEK -->
<!-- ===================== -->
<section>
  <h2>Usuń gatunek</h2>

  <select id="deleteGenreSelect">
    <% genres.forEach(genre => { %>
    <option value="<%= genre.id %>"><%= genre.name %></option>
    <% }) %>
  </select>

  <button id="deleteGenreBtn">Usuń</button>
</section>

<script>
  document
    .getElementById("deleteGenreBtn")
    .addEventListener("click", async () => {
      const id = document.getElementById("deleteGenreSelect").value;

      const res = await fetch(`/api/genre/delete/${id}`, {
        method: "DELETE",
      });

      if (res.ok) {
        window.location.href = "/genre/list";
      } else {
        alert("Błąd usuwania gatunku");
      }
    });
</script>

<br /><br />
<a href="/genre/list">Lista gatunków</a>
