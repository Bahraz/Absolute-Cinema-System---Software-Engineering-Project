<h1>Zarządzaj Płatnościami</h1>

<!-- ===================== -->
<!-- EDYTUJ PŁATNOŚĆ -->
<!-- ===================== -->
<section>
  <h2>Edytuj płatność</h2>

  <form id="editPaymentForm">
    <select id="paymentSelect" required>
      <option value="">--- wybierz płatność ---</option>
      <% payments.forEach(p => { %>
        <option
          value="<%= p.id %>"
          data-status="<%= p.status %>"
          data-provider="<%= p.provider %>"
        >
          <%= p.id.slice(-6) %> | <%= p.provider %> | <%= p.status %>
        </option>
      <% }) %>
    </select>

    <br /><br />

    <label>Status:</label><br />
    <select name="status" required>
      <option value="ZAINICJOWANA">ZAINICJOWANA</option>
      <option value="W TRAKCIE">W TRAKCIE</option>
      <option value="OPŁACONA">OPŁACONA</option>
      <option value="NIEUDANA">NIEUDANA</option>
      <option value="ZWRÓCONO">ZWRÓCONO</option>
    </select>

    <br /><br />
    <button type="submit">Zapisz zmiany</button>
  </form>
</section>

<script>
  const select = document.getElementById("paymentSelect");
  const form = document.getElementById("editPaymentForm");

  select.addEventListener("change", () => {
    const opt = select.options[select.selectedIndex];
    if (!opt.value) return;
    form.status.value = opt.dataset.status;
  });

  form.addEventListener("submit", async (e) => {
    e.preventDefault();

    const id = select.value;
    if (!id) return alert("Wybierz płatność");

    const res = await fetch(`/api/payment/update/${id}`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        status: form.status.value
      }),
    });

    if (res.ok) {
      window.location.href = "/payment/list";
    } else {
      alert("Błąd aktualizacji płatności");
    }
  });
</script>

<hr />

<!-- ===================== -->
<!-- USUŃ PŁATNOŚĆ -->
<!-- ===================== -->
<section>
  <h2>Usuń płatność</h2>

  <select id="deletePaymentSelect">
    <% payments.forEach(p => { %>
      <option value="<%= p.id %>">
        <%= p.id.slice(-6) %> | <%= p.provider %>
      </option>
    <% }) %>
  </select>

  <button id="deletePaymentBtn">Usuń</button>
</section>

<script>
  document
    .getElementById("deletePaymentBtn")
    .addEventListener("click", async () => {
      const id = document.getElementById("deletePaymentSelect").value;

      const res = await fetch(`/api/payment/delete/${id}`, {
        method: "DELETE",
      });

      if (res.ok) {
        window.location.href = "/payment/list";
      } else {
        alert("Błąd usuwania płatności");
      }
    });
</script>

<br />
<a href="/payment/list">Lista płatności</a>
