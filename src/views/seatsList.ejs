<h2>Lista miejsc</h2>

<select id="hallSelect">
  <option value="">--- wybierz salę ---</option>
  <% halls.forEach(h => { %>
  <option value="<%= h.id %>"><%= h.name %></option>
  <% }) %>
</select>

<div id="data" data-seats="<%= JSON.stringify(seats) %>"></div>

<hr />

<div id="result" style="display: none">
  <h3>Podsumowanie</h3>

  <p>
    Liczba miejsc w sali:
    <strong id="seatCount"></strong>
  </p>

  <h4>Miejsca:</h4>
  <ul id="seatList"></ul>
</div>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const dataEl = document.getElementById("data");
    const seats = JSON.parse(dataEl.dataset.seats);

    const hallSelect = document.getElementById("hallSelect");
    const resultDiv = document.getElementById("result");
    const seatCountEl = document.getElementById("seatCount");
    const seatListEl = document.getElementById("seatList");

    hallSelect.addEventListener("change", () => {
      const hallId = hallSelect.value;

      seatListEl.innerHTML = "";
      resultDiv.style.display = "none";

      if (!hallId) return;

      const filteredSeats = seats.filter((s) => s.hallId === hallId);

      seatCountEl.textContent = filteredSeats.length;

      filteredSeats.forEach((s) => {
        const li = document.createElement("li");
        li.textContent = `Rząd ${s.row}, miejsce ${s.seatNumber}`;
        seatListEl.appendChild(li);
      });

      resultDiv.style.display = "block";
    });
  });
</script>

<br />
