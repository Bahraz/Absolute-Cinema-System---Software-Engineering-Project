<h1>Zarządzaj Miejscami</h1>

<!-- DODAJ -->
<h2>Dodaj miejsce</h2>
<form id="addSeatForm">
  <select name="hall_id" required>
    <option value="">--- wybierz salę ---</option>
    <% halls.forEach(h => { %>
      <option value="<%= h.id %>"><%= h.name %></option>
    <% }) %>
  </select>

  <input type="number" name="row" placeholder="Rząd" required />
  <input type="number" name="seat_number" placeholder="Nr miejsca" required />
  <button type="submit">Dodaj</button>
</form>

<script>
  document.getElementById("addSeatForm").addEventListener("submit", async e => {
    e.preventDefault();
    const f = e.target;

    const res = await fetch("/api/seat/create", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        hall_id: f.hall_id.value,
        row: f.row.value,
        seat_number: f.seat_number.value
      })
    });

    if (res.ok) window.location.href = "/seat/list";
    else alert("Błąd dodawania miejsca");
  });
</script>

<hr />

<!-- EDYTUJ -->
<h2>Edytuj miejsce</h2>
<form id="editSeatForm">
  <select id="editSeatSelect">
    <option value="">--- wybierz miejsce ---</option>
    <% seats.forEach(s => { %>
      <option
        value="<%= s.id %>"
        data-hall="<%= s.hall.id %>"
        data-row="<%= s.row %>"
        data-seat="<%= s.seatNumber %>"
      >
        Sala <%= s.hall.name %> | Rząd <%= s.row %> | Miejsce <%= s.seatNumber %>
      </option>
    <% }) %>
  </select>

  <br /><br />

  <select name="hall_id" required>
    <% halls.forEach(h => { %>
      <option value="<%= h.id %>"><%= h.name %></option>
    <% }) %>
  </select>

  <input type="number" name="row" required />
  <input type="number" name="seat_number" required />

  <button type="submit">Zapisz</button>
</form>

<script>
  const sel = document.getElementById("editSeatSelect");
  const form = document.getElementById("editSeatForm");

  sel.addEventListener("change", () => {
    const o = sel.options[sel.selectedIndex];
    if (!o.value) return;

    form.hall_id.value = o.dataset.hall;
    form.row.value = o.dataset.row;
    form.seat_number.value = o.dataset.seat;
  });

  form.addEventListener("submit", async e => {
    e.preventDefault();
    const id = sel.value;
    if (!id) return alert("Wybierz miejsce");

    const res = await fetch(`/api/seat/update/${id}`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        hall_id: form.hall_id.value,
        row: form.row.value,
        seat_number: form.seat_number.value
      })
    });

    if (res.ok) window.location.href = "/seat/list";
    else alert("Błąd edycji");
  });
</script>

<hr />

<!-- USUŃ -->
<h2>Usuń miejsce</h2>
<select id="deleteSeatSelect">
  <% seats.forEach(s => { %>
    <option value="<%= s.id %>">
      Sala <%= s.hall.name %> | Rząd <%= s.row %> | Miejsce <%= s.seatNumber %>
    </option>
  <% }) %>
</select>

<button id="deleteSeatBtn">Usuń</button>

<script>
  document.getElementById("deleteSeatBtn").addEventListener("click", async () => {
    const id = document.getElementById("deleteSeatSelect").value;

    const res = await fetch(`/api/seat/delete/${id}`, { method: "DELETE" });
    if (res.ok) window.location.href = "/seat/list";
    else alert("Błąd usuwania");
  });
</script>

<br><br>
<a href="/seat/list">Lista miejsc</a>
