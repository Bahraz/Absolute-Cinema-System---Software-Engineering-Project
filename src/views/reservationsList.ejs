<h1>Lista rezerwacji</h1>

<section style="display: flex; justify-content: center">
  <div style="width: 90%; min-width: 800px">
    <table
      id="reservationsTable"
      border="1"
      cellpadding="8"
      cellspacing="0"
      style="width: 100%; border-collapse: collapse"
    >
      <thead style="background: #f0f0f0">
        <tr>
          <th>Użytkownik</th>
          <th>Film</th>
          <th>Sala</th>
          <th>Miejsce</th>
          <th>Start</th>
          <th>Bilet</th>
          <th>Status płatności</th>
          <th>Metoda</th>
        </tr>
      </thead>

      <tbody>
        <tr>
          <td colspan="6" style="text-align: center">Ładowanie…</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<script>
  async function loadReservations() {
    const tbody = document.querySelector("#reservationsTable tbody");
    const res = await fetch("/api/reservation/show");

    if (!res.ok) {
      tbody.innerHTML = `
        <tr>
          <td colspan="6" style="text-align:center;color:red;">
            Błąd ładowania danych
          </td>
        </tr>`;
      return;
    }

    const data = await res.json();

    if (!Array.isArray(data) || data.length === 0) {
      tbody.innerHTML = `
        <tr>
          <td colspan="6" style="text-align:center;">
            Brak rezerwacji
          </td>
        </tr>`;
      return;
    }

    tbody.innerHTML = "";

    data.forEach((r) => {
      const tr = document.createElement("tr");

      const user = r.user_id
        ? `${r.user_id.name} ${r.user_id.surname}<br/><small>${r.user_id.email}</small>`
        : "—";

      const movie = r.screening_id?.movie_id?.title ?? "—";
      const hall = r.screening_id?.hall_id?.name ?? "—";
      const start = r.screening_id?.start_at
        ? new Date(r.screening_id.start_at).toLocaleString()
        : "—";

      const seat = r.seats_id
        ? `Rząd ${r.seats_id.row}, miejsce ${r.seats_id.seat_number}`
        : "—";

      const ticket = r.ticket_id
        ? `${String(r.ticket_id._id).slice(-6)}<br/><small>${
            r.ticket_id.status
          }</small>`
        : "—";

      const paymentStatus = r.ticket_id?.payment_id?.status ?? "—";

      const paymentProvider = r.ticket_id?.payment_id?.provider ?? "—";

      tr.innerHTML = `
  <td>${user}</td>
  <td>${movie}</td>
  <td>${hall}</td>
  <td>${seat}</td>
  <td>${start}</td>
  <td>${ticket}</td>
  <td>${paymentStatus}</td>
  <td>${paymentProvider}</td>
`;

      tbody.appendChild(tr);
    });
  }

  loadReservations();
</script>

<br />
<a href="/reservation">Powrót</a>
