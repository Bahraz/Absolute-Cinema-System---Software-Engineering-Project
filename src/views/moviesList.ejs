<!-- ================= SZCZEGÓŁY FILMU ================= -->
<h2>Szczegóły filmu</h2>

<select id="movieSelect">
  <option value="">-- wybierz film --</option>
  <% movies.forEach(movie => { %>
  <option value="<%= movie.id %>"><%= movie.title %></option>
  <% }) %>
</select>

<button onclick="goToDetails()">Zobacz szczegóły</button>

<script>
  function goToDetails() {
    const id = document.getElementById("movieSelect").value;
    if (!id) return alert("Wybierz film");

    window.location.href = `/movie/list/${id}`;
  }
</script>

<hr />

<h2>Lista Filmów</h2>

<ul>
  <% movies.forEach(movie => { %>
  <li>
    <strong><%= movie.title %></strong><br />
    Rok premiery: <%= movie.release_year %><br />
    Czas trwania: <%= movie.duration %> min<br />
    <em><%= movie.description %></em>
  </li>
  <br />
  <% }) %>
</ul>

<br />
<a href="/movie">Powrót</a><br />
