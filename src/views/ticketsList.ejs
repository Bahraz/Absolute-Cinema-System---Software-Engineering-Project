<h2>Lista Ticketów</h2>

<ul>
  <% tickets.forEach(t => { %>
  <li>
    <strong>Ticket:</strong> <%= t.id %><br />
    Status: <%= t.status %><br />
    Kwota: <%= t.amount %> zł<br />
    Wygasa: <%= new Date(t.expiresAt).toLocaleString() %>
  </li>
  <% }) %>
</ul>

<br />
<a href="/ticket">Powrót</a>
