<h1>Zarządzaj Filmami</h1>

<!-- ===================== -->
<!-- DODAJ FILM -->
<!-- ===================== -->
<div name="AddMovie">
  <h2>Dodaj film</h2>

  <form id="addMovieForm">
    <input name="title" type="text" placeholder="Tytuł filmu..." required />
    <input
      name="duration"
      type="number"
      placeholder="Czas trwania (min)..."
      required
    />
    <input
      name="release_year"
      type="number"
      placeholder="Rok premiery..."
      required
    /><br /><br />
    <textarea
      name="description"
      placeholder="Opis filmu..."
      required
    ></textarea>
    <br /><br />
    <button type="submit">Dodaj film</button>
  </form>

  <script>
    document
      .getElementById("addMovieForm")
      .addEventListener("submit", async (e) => {
        e.preventDefault();

        const form = e.target;

        const res = await fetch("/api/movie/create", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            title: form.title.value,
            duration: Number(form.duration.value),
            release_year: Number(form.release_year.value),
            description: form.description.value,
          }),
        });

        if (res.ok) {
          window.location.href = "/movie/list";
        } else {
          const err = await res.json();
          alert(err.error || "Błąd dodawania filmu");
        }
      });
  </script>
</div>

<hr />

<!-- ===================== -->
<!-- EDYTUJ FILM -->
<!-- ===================== -->
<div name="UpdateMovie">
  <h2>Edytuj film</h2>

  <form id="editMovieForm">
    <select id="editMovieSelect">
      <option value="">--- wybierz film ---</option>
      <% movies.forEach(movie => { %>
      <option
        value="<%= movie.id %>"
        data-title="<%= movie.title %>"
        data-duration="<%= movie.duration %>"
        data-year="<%= movie.release_year %>"
        data-description="<%= movie.description %>"
      >
        <%= movie.title %> (<%= movie.release_year %>)
      </option>
      <% }) %>
    </select>

    <br /><br />

    <input name="title" type="text" placeholder="Tytuł filmu..." />
    <input name="duration" type="number" placeholder="Czas trwania (min)..." />
    <input
      name="release_year"
      type="number"
      placeholder="Rok premiery..."
    /><br /><br />
    <textarea name="description" placeholder="Opis filmu..."></textarea>

    <br /><br />
    <button type="submit">Zaktualizuj</button>
  </form>

  <script>
    const editMovieSelect = document.getElementById("editMovieSelect");
    const editMovieForm = document.getElementById("editMovieForm");

    function fillMovieForm() {
      const option = editMovieSelect.options[editMovieSelect.selectedIndex];

      if (!option.value) {
        editMovieForm.title.value = "";
        editMovieForm.duration.value = "";
        editMovieForm.release_year.value = "";
        editMovieForm.description.value = "";
        return;
      }

      editMovieForm.title.value = option.dataset.title || "";
      editMovieForm.duration.value = option.dataset.duration || "";
      editMovieForm.release_year.value = option.dataset.year || "";
      editMovieForm.description.value = option.dataset.description || "";
    }

    editMovieSelect.addEventListener("change", fillMovieForm);

    editMovieForm.addEventListener("submit", async (e) => {
      e.preventDefault();

      const id = editMovieSelect.value;

      if (!id) {
        alert("Wybierz film");
        return;
      }

      const res = await fetch(`/api/movie/update/${id}`, {
        method: "PATCH",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          title: editMovieForm.title.value.trim(),
          duration: Number(editMovieForm.duration.value),
          release_year: Number(editMovieForm.release_year.value),
          description: editMovieForm.description.value.trim(),
        }),
      });

      if (res.ok) {
        window.location.href = "/movie/list";
      } else {
        const err = await res.json();
        alert(err.error || "Błąd edycji filmu");
      }
    });
  </script>
</div>

<hr />

<!-- ================= DODAJ AKTORA ================= -->
<h2>Dodaj aktora do filmu</h2>

<form id="addActorForm">
  <select name="movieId" required>
    <option value="">-- film --</option>
    <% movies.forEach(movie => { %>
    <option value="<%= movie.id %>"><%= movie.title %></option>
    <% }) %>
  </select>

  <select name="actorId" required>
    <option value="">-- aktor --</option>
    <% actors.forEach(actor => { %>
    <option value="<%= actor.id %>">
      <%= actor.name %> <%= actor.surname %>
    </option>
    <% }) %>
  </select>

  <button type="submit">Dodaj aktora</button>
</form>

<hr />

<script>
  document
    .getElementById("addActorForm")
    .addEventListener("submit", async (e) => {
      e.preventDefault();

      const movieId = e.target.movieId.value;
      const actorId = e.target.actorId.value;

      const res = await fetch(`/api/movie/${movieId}/actors`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ actorId }),
      });

      const data = await res.json();
      alert(data.message || data.error);
    });
</script>

<h2>Usuń aktora z filmu</h2>

<form id="removeActorForm">
  <!-- FILM -->
  <select id="removeActorMovieSelect" required>
    <option value="">-- wybierz film --</option>
    <% movies.forEach(movie => { %>
    <option value="<%= movie.id %>"><%= movie.title %></option>
    <% }) %>
  </select>

  <!-- AKTOR (dynamiczny) -->
  <select id="removeActorSelect" required disabled>
    <option value="">-- wybierz aktora --</option>
  </select>

  <button type="submit">Usuń aktora</button>
</form>

<script>
  const movieSelect = document.getElementById("removeActorMovieSelect");
  const actorSelect = document.getElementById("removeActorSelect");

  movieSelect.addEventListener("change", async () => {
    const movieId = movieSelect.value;

    actorSelect.innerHTML = '<option value="">-- wybierz aktora --</option>';
    actorSelect.disabled = true;

    if (!movieId) return;

    const res = await fetch(`/api/movie/${movieId}/actors`);
    const actors = await res.json();

    if (actors.length === 0) {
      actorSelect.innerHTML =
        '<option value="">Brak aktorów w tym filmie</option>';
      return;
    }

    actors.forEach((actor) => {
      const opt = document.createElement("option");
      opt.value = actor.id;
      opt.textContent = `${actor.name} ${actor.surname}`;
      actorSelect.appendChild(opt);
    });

    actorSelect.disabled = false;
  });

  document
    .getElementById("removeActorForm")
    .addEventListener("submit", async (e) => {
      e.preventDefault();

      const movieId = movieSelect.value;
      const actorId = actorSelect.value;

      if (!movieId || !actorId) {
        alert("Wybierz film i aktora");
        return;
      }

      const res = await fetch(`/api/movie/${movieId}/actors/${actorId}`, {
        method: "DELETE",
      });

      const data = await res.json();
      alert(data.message || data.error);

      // odśwież listę aktorów po usunięciu
      movieSelect.dispatchEvent(new Event("change"));
    });
</script>

<!-- ================= DODAJ GATUNEK ================= -->
<h2>Dodaj gatunek do filmu</h2>

<form id="addGenreForm">
  <select name="movieId" required>
    <option value="">-- film --</option>
    <% movies.forEach(movie => { %>
    <option value="<%= movie.id %>"><%= movie.title %></option>
    <% }) %>
  </select>

  <select name="genreId" required>
    <option value="">-- gatunek --</option>
    <% genres.forEach(genre => { %>
    <option value="<%= genre.id %>"><%= genre.name %></option>
    <% }) %>
  </select>

  <button type="submit">Dodaj gatunek</button>
</form>
<script>
  document
    .getElementById("addGenreForm")
    .addEventListener("submit", async (e) => {
      e.preventDefault();

      const movieId = e.target.movieId.value;
      const genreId = e.target.genreId.value;

      const res = await fetch(`/api/movie/${movieId}/genres`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ genreId }),
      });

      const data = await res.json();
      alert(data.message || data.error);
    });
</script>


<h2>Usuń gatunek z filmu</h2>

<form id="removeGenreForm">
  <!-- FILM -->
  <select id="removeGenreMovieSelect" required>
    <option value="">-- wybierz film --</option>
    <% movies.forEach(movie => { %>
      <option value="<%= movie.id %>"><%= movie.title %></option>
    <% }) %>
  </select>

  <!-- GATUNEK (dynamiczny) -->
  <select id="removeGenreSelect" required disabled>
    <option value="">-- wybierz gatunek --</option>
  </select>

  <button type="submit">Usuń gatunek</button>
</form>

<script>
const genreMovieSelect = document.getElementById("removeGenreMovieSelect");
const genreSelect = document.getElementById("removeGenreSelect");

genreMovieSelect.addEventListener("change", async () => {
  const movieId = genreMovieSelect.value;

  genreSelect.innerHTML = '<option value="">-- wybierz gatunek --</option>';
  genreSelect.disabled = true;

  if (!movieId) return;

  const res = await fetch(`/api/movie/${movieId}/genres`);
  const genres = await res.json();

  if (genres.length === 0) {
    genreSelect.innerHTML =
      '<option value="">Brak gatunków w tym filmie</option>';
    return;
  }

  genres.forEach(genre => {
    const opt = document.createElement("option");
    opt.value = genre.id;
    opt.textContent = genre.name;
    genreSelect.appendChild(opt);
  });

  genreSelect.disabled = false;
});

document.getElementById("removeGenreForm").addEventListener("submit", async e => {
  e.preventDefault();

  const movieId = genreMovieSelect.value;
  const genreId = genreSelect.value;

  if (!movieId || !genreId) {
    alert("Wybierz film i gatunek");
    return;
  }

  const res = await fetch(
    `/api/movie/${movieId}/genres/${genreId}`,
    { method: "DELETE" }
  );

  const data = await res.json();
  alert(data.message || data.error);

  // 🔄 odśwież listę po usunięciu
  genreMovieSelect.dispatchEvent(new Event("change"));
});
</script>

<!-- ===================== -->
<!-- USUŃ FILM -->
<!-- ===================== -->
<div name="DeleteMovie">
  <h2>Usuń film</h2>

  <select id="deleteMovieSelect">
    <% movies.forEach(movie => { %>
    <option value="<%= movie.id %>">
      <%= movie.title %> (<%= movie.release_year %>)
    </option>
    <% }) %>
  </select>

  <button id="deleteMovieBtn">Usuń</button>

  <script>
    document
      .getElementById("deleteMovieBtn")
      .addEventListener("click", async () => {
        const id = document.getElementById("deleteMovieSelect").value;

        const res = await fetch(`/api/movie/delete/${id}`, {
          method: "DELETE",
        });

        if (res.ok) {
          window.location.href = "/movie/list";
        } else {
          alert("Błąd usuwania filmu");
        }
      });
  </script>
</div>

