<%- include("partials/header", { title: "Moje rezerwacje - Absolute Cinema" }) %> 
<%- include("partials/sidebar") %>

<div class="reservations-container">
  <header class="page-header">
    <h1>🎟️ Twoje Bilety</h1>
    <p>Zarządzaj swoimi aktywnymi rezerwacjami i sprawdź status płatności.</p>
  </header>

  <div class="reservations-list">
    <% if (!reservations || reservations.length === 0) { %>
      <div class="no-data">
        <p>Nie masz jeszcze żadnych rezerwacji.</p>
        <a href="/user/dashboard" class="btn-primary">Przeglądaj seanse</a>
      </div>
    <% } %> 

    <% reservations.forEach(r => { %>
      <div class="reservation-card" data-id="<%= r._id %>">
        
        <div class="card-section movie-info">
          <div class="movie-title">
            <span class="icon">🎬</span>
            <h3><%= r.screening_id?.movie_id?.title || "Film niedostępny" %></h3>
          </div>
          <div class="screening-details">
            <p><span>📅</span> <%= r.screening_id?.start_at ? new Date(r.screening_id.start_at).toLocaleString('pl-PL', { day: '2-digit', month: '2-digit', hour: '2-digit', minute: '2-digit' }) : "—" %></p>
            <p><span>🏛️</span> <%= r.screening_id?.hall_id?.name || "—" %></p>
            <p><span>💺</span> <% if (r.seats_id) { %> Rząd <b><%= r.seats_id.row %></b>, Miejsce <b><%= r.seats_id.seat_number %></b> <% } else { %> Brak przypisanego miejsca <% } %></p>
          </div>
        </div>

        <div class="card-section ticket-info">
          <div class="section-label">Bilet i QR</div>
          <% if (r.ticket_id) { %>
            <div class="ticket-wrapper">
              <div class="ticket-details">
                <p class="id-text">ID: #<%= r.ticket_id._id.toString().slice(-6) %></p>
                <p class="price-tag"><%= r.ticket_id.amount %> zł</p>
                <span class="badge status-<%= r.ticket_id.status?.toLowerCase() %>">
                  <%= r.ticket_id.status %>
                </span>
              </div>
              
              <% if (r.ticket_id.qr_code) { %>
                <div class="qr-container">
                  <div class="qr-frame">
                    <img src="<%= r.ticket_id.qr_code %>" alt="QR Code" class="qr-image">
                  </div>
                  <span class="qr-zoom-hint">Najedź, by powiększyć</span>
                </div>
              <% } %>
            </div>
          <% } else { %>
            <p class="empty-state">Brak danych biletu</p>
          <% } %>
        </div>

        <div class="card-section payment-info">
          <div class="section-label">Płatność</div>
          <% if (r.ticket_id && r.ticket_id.payment_id) { %>
            <p class="provider-text">Metoda: <b><%= r.ticket_id.payment_id.provider %></b></p>
            <span class="badge payment-<%= r.ticket_id.payment_id.status?.toLowerCase() %>">
              <%= r.ticket_id.payment_id.status %>
            </span>
          <% } else { %>
            <p class="empty-state">Oczekiwanie...</p>
          <% } %>
        </div>

        <div class="card-actions">
          <button class="btn-cancel cancel">Anuluj rezerwację</button>
          <div class="msg"></div>
        </div>

      </div>
    <% }) %>
  </div>
</div>

<style>
  :root {
    --bg-dark: #141414;
    --card-bg: #1f1f1f;
    --cinema-red: #e50914;
    --text-white: #ffffff;
    --text-gray: #b3b3b3;
    --qr-bg: #ffffff;
  }

  .reservations-container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 30px 20px;
    font-family: 'Segoe UI', sans-serif;
  }

  .page-header {
    margin-bottom: 40px;
    border-left: 5px solid var(--cinema-red);
    padding-left: 20px;
  }

  .page-header h1 { color: var(--text-white); font-size: 2.2rem; margin: 0; }
  .page-header p { color: var(--text-gray); margin-top: 5px; }

  /* KARTA REZERWACJI */
  .reservation-card {
    background: var(--card-bg);
    border: 1px solid #333;
    border-radius: 12px;
    margin-bottom: 20px;
    display: grid;
    grid-template-columns: 1.5fr 1.5fr 1fr auto;
    overflow: visible; /* Ważne dla powiększania QR */
    transition: transform 0.2s, border-color 0.2s;
  }

  .reservation-card:hover {
    border-color: #555;
    background: #252525;
  }

  .card-section {
    padding: 20px;
    border-right: 1px solid #333;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .section-label {
    font-size: 0.7rem;
    text-transform: uppercase;
    color: var(--text-gray);
    letter-spacing: 1px;
    margin-bottom: 12px;
  }

  /* INFO O FILMIE */
  .movie-info { border-left: 4px solid var(--cinema-red); }
  .movie-title h3 { margin: 0 0 10px 0; color: var(--text-white); font-size: 1.2rem; }
  .screening-details p { margin: 4px 0; color: var(--text-gray); font-size: 0.85rem; }

  /* UKŁAD BILETU + QR */
  .ticket-wrapper {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .ticket-details { flex: 1; }
  .price-tag { font-size: 1.3rem; font-weight: bold; color: var(--text-white); margin: 5px 0; }
  .id-text { font-size: 0.8rem; color: var(--text-gray); }

  /* KOD QR */
  .qr-container {
    position: relative;
    z-index: 5;
  }

  .qr-frame {
    background: var(--qr-bg);
    padding: 4px;
    border-radius: 6px;
    transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: zoom-in;
  }

  .qr-image {
    width: 65px;
    height: 65px;
    display: block;
    image-rendering: pixelated;
  }

  .qr-frame:hover {
    transform: scale(2.5) translateX(-15px);
    box-shadow: 0 10px 30px rgba(0,0,0,0.8);
  }

  .qr-zoom-hint {
    position: absolute;
    bottom: -15px;
    left: -10px;
    right: -10px;
    font-size: 0.6rem;
    color: var(--text-gray);
    text-align: center;
    opacity: 0;
    pointer-events: none;
  }

  .qr-frame:hover + .qr-zoom-hint { opacity: 1; }

  /* BADGES */
  .badge {
    padding: 4px 10px;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: bold;
    display: inline-block;
  }
  .status-potwierdzony, .payment-completed, .status-aktywny { background: #1b5e20; color: #81c784; }
  .status-oczekujący, .payment-pending, .status-nieaktywny { background: #4a3703; color: #ffd54f; }
  .payment-failed { background: #b71c1c; color: #ef5350; }

  /* AKCJE */
  .card-actions {
    padding: 20px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-width: 160px;
    gap: 8px;
  }

  .btn-cancel {
    background: transparent;
    border: 1px solid #c0392b;
    color: #c0392b;
    padding: 10px;
    border-radius: 6px;
    cursor: pointer;
    font-weight: bold;
    transition: 0.2s;
  }

  .btn-cancel:hover:not(:disabled) {
    background: #c0392b;
    color: white;
  }

  .btn-cancel:disabled { opacity: 0.5; cursor: not-allowed; }

  .msg { font-size: 0.75rem; text-align: center; min-height: 1em; }

  /* Responsywność */
  @media (max-width: 900px) {
    .reservation-card { grid-template-columns: 1fr 1fr; }
    .card-section { border-bottom: 1px solid #333; border-right: none; }
    .card-actions { grid-column: span 2; }
    .qr-frame:hover { transform: scale(2); }
  }

  @media (max-width: 550px) {
    .reservation-card { grid-template-columns: 1fr; }
    .card-actions { grid-column: span 1; }
    .ticket-wrapper { justify-content: space-between; }
  }
</style>

<script>
  document.querySelectorAll(".cancel").forEach((btn) => {
    btn.onclick = async (e) => {
      const card = e.target.closest(".reservation-card");
      const msg = card.querySelector(".msg");
      
      if (!confirm("Czy na pewno chcesz anulować tę rezerwację?")) return;

      btn.disabled = true;
      const originalText = btn.innerText;
      btn.innerText = "Anulowanie...";

      try {
        const res = await fetch(`/api/user/reservations/${card.dataset.id}`, {
          method: "DELETE",
        });

        if (!res.ok) throw new Error();

        msg.innerText = "✅ Anulowano";
        msg.style.color = "#2ecc71";
        
        card.style.opacity = "0.5";
        card.style.pointerEvents = "none";
        
        setTimeout(() => {
          card.style.transition = "0.5s";
          card.style.transform = "translateX(100px)";
          card.style.opacity = "0";
          setTimeout(() => card.remove(), 500);
        }, 800);

      } catch (err) {
        msg.innerText = "❌ Błąd anulowania";
        msg.style.color = "#ff4d4d";
        btn.disabled = false;
        btn.innerText = originalText;
      }
    };
  });
</script>

<%- include("partials/footer") %>