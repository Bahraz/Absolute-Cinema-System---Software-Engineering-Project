<%- include("partials/header", { title: "Rezerwacja - Absolute Cinema" }) %> 
<%- include("partials/sidebar") %>

<div class="reservation-container">
  <header class="page-header">
    <h1>🎬 Nowa rezerwacja</h1>
    <p>Wybierz seans i zajmij najlepsze miejsce na sali.</p>
  </header>

  <form id="reservationForm" class="styled-form">
    <div class="form-section">
      <div class="form-group">
        <label for="screening">Seans i godzina</label>
        <div class="select-wrapper">
          <select id="screening" required>
            <option value="" disabled selected>-- wybierz film i godzinę --</option>
            <% screenings.forEach(s => { %> 
              <% if (s.movie_id && s.hall_id) { %>
                <option value="<%= s._id %>">
                  <%= s.movie_id.title %> | <%= s.hall_id.name %> | <%= new Date(s.start_at).toLocaleString('pl-PL', {day: '2-digit', month: '2-digit', hour: '2-digit', minute:'2-digit'}) %>
                </option>
              <% } %> 
            <% }) %>
          </select>
        </div>
      </div>
    </div>

    <div class="map-section card-dark">
      <label class="section-label">Wybierz miejsce na sali</label>
      
      <div class="hall-visual">
        <div class="screen-wrap">
          <div class="screen-glow"></div>
          <div class="screen-label">EKRAN</div>
        </div>
        
        <div id="seatsContainer">
          <div class="placeholder-msg">Wybierz seans powyżej, aby zobaczyć mapę miejsc...</div>
        </div>
      </div>
      
      <div class="legend">
        <div class="legend-item"><span class="seat-sample available"></span> Wolne</div>
        <div class="legend-item"><span class="seat-sample selected"></span> Wybrane</div>
        <div class="legend-item"><span class="seat-sample occupied"></span> Zajęte</div>
      </div>
    </div>

    <input type="hidden" id="selectedSeatId" required>

    <div class="payment-section">
      <div class="form-group">
        <label for="paymentSelect">Metoda płatności</label>
        <div class="select-wrapper">
          <select id="paymentSelect">
            <option value="KARTA">💳 Karta płatnicza</option>
            <option value="BLIK">📱 BLIK</option>
            <option value="PRZELEW">🌐 Przelew online</option>
            <option value="GOTÓWKA">💵 Gotówka w kasie</option>
          </select>
        </div>
      </div>

      <div id="priceBox" class="price-card" style="display: none">
        <div class="price-content">
          <span class="price-label">Do zapłaty:</span>
          <span class="price-amount"><span id="priceValue">0</span> zł</span>
        </div>
        <div class="price-sub">Cena zawiera podatek VAT oraz opłatę serwisową.</div>
      </div>
    </div>

    <div class="form-actions">
      <button type="submit" class="btn-confirm">Potwierdź rezerwację</button>
      <div class="msg" id="formResponse"></div>
    </div>
  </form>
</div>

<style>
  :root {
    --primary-red: #e50914;
    --dark-bg: #141414;
    --card-bg: #1f1f1f;
    --input-bg: #2b2b2b;
    --text-main: #ffffff;
    --text-gray: #b3b3b3;
    --seat-free: #43a047;
    --seat-selected: #1e88e5;
    --seat-occupied: #333333;
  }

  .reservation-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 30px 20px;
    font-family: 'Inter', sans-serif;
  }

  .page-header { margin-bottom: 30px; }
  .page-header h1 { font-size: 2.2rem; color: var(--text-main); margin-bottom: 5px; }
  .page-header p { color: var(--text-gray); }

  /* FORMULARZ */
  .form-group { margin-bottom: 25px; }
  .form-group label { display: block; font-size: 0.9rem; color: var(--text-gray); margin-bottom: 10px; text-transform: uppercase; letter-spacing: 1px; }

  .select-wrapper select {
    width: 100%;
    padding: 12px 15px;
    background: var(--input-bg);
    border: 1px solid #444;
    border-radius: 8px;
    color: white;
    font-size: 1rem;
    cursor: pointer;
    transition: 0.3s;
  }

  .select-wrapper select:focus { outline: none; border-color: var(--primary-red); }

  /* MAPA SALI */
  .card-dark {
    background: #000;
    border-radius: 15px;
    padding: 40px 20px;
    margin-bottom: 30px;
    border: 1px solid #222;
  }

  .section-label { text-align: center; display: block; margin-bottom: 40px; color: var(--text-gray); }

  .screen-wrap { margin-bottom: 50px; text-align: center; }
  .screen-glow { width: 70%; height: 4px; background: #55aaff; margin: 0 auto; border-radius: 50%; box-shadow: 0 0 20px 5px #55aaff; }
  .screen-label { color: #55aaff; font-size: 10px; letter-spacing: 10px; margin-top: 10px; opacity: 0.7; }

  .seat-row { display: flex; justify-content: center; align-items: center; gap: 10px; margin-bottom: 15px; }
  .row-label { width: 60px; font-size: 10px; color: #444; text-transform: uppercase; text-align: right; margin-right: 15px; }

  .seat {
    width: 34px; height: 34px; background: var(--seat-free); border-radius: 6px 6px 12px 12px;
    cursor: pointer; color: white; font-size: 11px; display: flex; align-items: center; justify-content: center;
    transition: 0.2s; font-weight: bold; border-bottom: 4px solid rgba(0,0,0,0.3);
  }

  .seat:hover:not(.occupied) { transform: scale(1.15); filter: brightness(1.2); }
  .seat.selected { background: var(--seat-selected) !important; box-shadow: 0 0 15px var(--seat-selected); border-bottom-color: #0d47a1; }
  .seat.occupied { background: var(--seat-occupied); color: #555; cursor: not-allowed; border-bottom: none; opacity: 0.5; }

  /* LEGENDA */
  .legend { display: flex; justify-content: center; gap: 20px; margin-top: 40px; }
  .legend-item { display: flex; align-items: center; gap: 8px; color: var(--text-gray); font-size: 13px; }
  .seat-sample { width: 18px; height: 18px; border-radius: 4px; }
  .seat-sample.available { background: var(--seat-free); }
  .seat-sample.selected { background: var(--seat-selected); }
  .seat-sample.occupied { background: var(--seat-occupied); }

  /* POPRAWIONY PRICE CARD (ZGODNIE Z TWOIM ZDJĘCIEM) */
  .price-card {
    background: var(--card-bg);
    border: 1px solid #333;
    border-left: 5px solid var(--primary-red);
    padding: 20px;
    border-radius: 8px;
    margin: 30px 0;
  }

  .price-content { display: flex; justify-content: space-between; align-items: center; margin-bottom: 5px; }
  .price-label { color: var(--text-gray); font-weight: 600; }
  .price-amount { color: var(--text-main); font-size: 1.5rem; font-weight: 800; }
  .price-sub { font-size: 11px; color: #666; font-style: italic; }

  /* PRZYCISK */
  .btn-confirm {
    width: 100%;
    padding: 16px;
    background: var(--primary-red);
    color: white;
    border: none;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: bold;
    cursor: pointer;
    transition: 0.3s;
  }

  .btn-confirm:hover { background: #ff0a16; transform: translateY(-2px); box-shadow: 0 10px 20px rgba(229, 9, 20, 0.3); }

  .msg { margin-top: 20px; text-align: center; padding: 10px; border-radius: 6px; font-weight: bold; }
  .msg.error { background: rgba(211, 47, 47, 0.1); color: #ff5252; }
  .msg.success { background: rgba(56, 142, 60, 0.1); color: #69f0ae; }
</style>

<script>
  // ... (Logika JavaScript pozostaje taka sama, dostosowałem tylko ID komunikatów)
  const screeningSelect = document.getElementById("screening");
  const seatsContainer = document.getElementById("seatsContainer");
  const selectedSeatIdInput = document.getElementById("selectedSeatId");
  const priceBox = document.getElementById("priceBox");
  const priceValue = document.getElementById("priceValue");
  const msgEl = document.getElementById("formResponse");

  screeningSelect.addEventListener("change", async () => {
    const screeningId = screeningSelect.value;
    if (!screeningId) {
      seatsContainer.innerHTML = '<div class="placeholder-msg">Wybierz seans powyżej...</div>';
      priceBox.style.display = "none";
      return;
    }

    seatsContainer.innerHTML = '<div class="placeholder-msg">Ładowanie mapy...</div>';

    try {
      const [seatsRes, priceRes] = await Promise.all([
        fetch(`/api/user/reservations/screenings/${screeningId}/seats`),
        fetch(`/api/user/reservations/screenings/${screeningId}/price`)
      ]);

      const seats = await seatsRes.json();
      const priceData = await priceRes.json();

      priceValue.innerText = priceData.price;
      priceBox.style.display = "block";
      renderHall(seats);
    } catch (err) {
      seatsContainer.innerHTML = '<div class="msg error">Błąd ładowania danych.</div>';
    }
  });

  function renderHall(seats) {
    seatsContainer.innerHTML = "";
    const rowsMap = {};
    seats.forEach(s => {
      if (!rowsMap[s.row]) rowsMap[s.row] = [];
      rowsMap[s.row].push(s);
    });

    Object.keys(rowsMap).sort((a,b) => a-b).forEach(rowNum => {
      const rowDiv = document.createElement("div");
      rowDiv.classList.add("seat-row");

      const label = document.createElement("div");
      label.classList.add("row-label");
      label.innerText = `Rząd ${rowNum}`;
      rowDiv.appendChild(label);

      rowsMap[rowNum].sort((a,b) => a.seat_number - b.seat_number).forEach(seat => {
        const seatEl = document.createElement("div");
        seatEl.classList.add("seat");
        if (seat.is_occupied) seatEl.classList.add("occupied");
        seatEl.innerText = seat.seat_number;

        seatEl.onclick = () => {
          if (seatEl.classList.contains("occupied")) return;
          document.querySelectorAll(".seat.selected").forEach(s => s.classList.remove("selected"));
          seatEl.classList.add("selected");
          selectedSeatIdInput.value = seat._id;
        };
        rowDiv.appendChild(seatEl);
      });
      seatsContainer.appendChild(rowDiv);
    });
  }

  document.getElementById("reservationForm").onsubmit = async (e) => {
    e.preventDefault();
    if (!selectedSeatIdInput.value) {
      msgEl.innerText = "⚠️ Wybierz miejsce!";
      msgEl.className = "msg error";
      return;
    }

    msgEl.innerText = "Przetwarzanie...";
    msgEl.className = "msg";

    try {
      const res = await fetch("/api/user/reservation", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          screening_id: screeningSelect.value,
          seats_id: selectedSeatIdInput.value,
          payment_provider: document.getElementById("paymentSelect").value,
        }),
      });

      if (res.ok) {
        msgEl.innerText = "✅ Sukces! Przekierowanie...";
        msgEl.className = "msg success";
        setTimeout(() => window.location.href = "/user/my-reservations", 1000);
      } else {
        const d = await res.json();
        msgEl.innerText = d.error;
        msgEl.className = "msg error";
      }
    } catch (err) {
      msgEl.innerText = "Błąd połączenia.";
      msgEl.className = "msg error";
    }
  };
</script>

<%- include("partials/footer") %>