<a href="/admin">Admin Panel</a><br /><br />

<h1>Zarządzaj Rezerwacjami</h1>

<!-- ================================================= -->
<!-- ================= CREATE ======================== -->
<!-- ================================================= -->

<section>
  <h2>Utwórz rezerwację</h2>

  <form id="addReservationForm">
    <label>
      Użytkownik:
      <select name="user_id" required>
        <option value="">--- wybierz użytkownika ---</option>
        <% users.forEach(u => { %>
        <option value="<%= u.id %>">
          <%= u.name %> <%= u.surname %> (<%= u.email %>)
        </option>
        <% }) %>
      </select>
    </label>

    <br /><br />

    <label>
      Seans:
      <select id="screeningSelect" name="screening_id" required>
        <option value="">--- wybierz seans ---</option>
        <% screenings.forEach(s => { %>
        <option value="<%= s.id %>">
          <%= s.movieTitle %> | <%= s.hallName %> | <%= new
          Date(s.startAt).toLocaleString() %>
        </option>
        <% }) %>
      </select>
    </label>

    <br /><br />

    <label>
      Miejsca:
      <select
        id="seatSelect"
        name="seat_ids"
        multiple
        required
        disabled
        size="6"
      ></select>
    </label>

    <br /><br />

    <label>
      Metoda płatności:
      <select name="payment_provider" required>
        <option value="">---</option>
        <option value="KARTA">Karta</option>
        <option value="PRZELEW">Przelew</option>
        <option value="BLIK">BLIK</option>
        <option value="GOTÓWKA">Gotówka</option>
      </select>
    </label>

    <br /><br />

    <label>
      Status płatności:
      <select name="payment_status" required>
        <option value="">---</option>
        <option value="ZAINICJOWANA">Zainicjowana</option>
        <option value="W TRAKCIE">W trakcie</option>
        <option value="OPŁACONA">Opłacona</option>
        <option value="NIEUDANA">Nieudana</option>
        <option value="ZWRÓCONO">Zwrócono</option>
      </select>
    </label>

    <br /><br />

    <button type="submit">Utwórz rezerwację</button>
  </form>
</section>

<hr />

<!-- ================================================= -->
<!-- ================= EDIT ========================== -->
<!-- ================================================= -->

<h2>Edytuj rezerwację</h2>

<label>
  Wybierz rezerwację:
  <select id="reservationSelect">
    <option value="">---</option>
    <% reservations.forEach(r => { %>
    <option value="<%= r.id %>">
      <%= r.userName %> | <%= r.movieTitle %> | <%= new
      Date(r.startAt).toLocaleString() %>
    </option>
    <% }) %>
  </select>
</label>

<br /><br />

<form id="editReservationForm">
  <input type="hidden" name="reservation_id" />

  <label>
    Użytkownik:
    <select name="user_id">
      <option value="">(bez zmiany)</option>
      <% users.forEach(u => { %>
      <option value="<%= u.id %>"><%= u.name %> <%= u.surname %></option>
      <% }) %>
    </select>
  </label>

  <br /><br />

  <label>
    Seans:
    <select name="screening_id" id="editScreeningSelect">
      <option value="">(bez zmiany)</option>
      <% screenings.forEach(s => { %>
      <option value="<%= s.id %>">
        <%= s.movieTitle %> | <%= new Date(s.startAt).toLocaleString() %>
      </option>
      <% }) %>
    </select>
  </label>

  <br /><br />

  <label>
    Miejsce:
    <select name="seats_id" id="editSeatSelect"></select>
  </label>

  <br /><br />

  <label>
    Status płatności:
    <select name="payment_status">
      <option value="">(bez zmiany)</option>
      <option value="ZAINICJOWANA">Zainicjowana</option>
      <option value="W TRAKCIE">W trakcie</option>
      <option value="OPŁACONA">Opłacona</option>
      <option value="NIEUDANA">Nieudana</option>
      <option value="ZWRÓCONO">Zwrócono</option>
    </select>
  </label>

  <br /><br />

  <label>
    Metoda płatności:
    <select name="payment_provider">
      <option value="">(bez zmiany)</option>
      <option value="KARTA">Karta</option>
      <option value="PRZELEW">Przelew</option>
      <option value="BLIK">BLIK</option>
      <option value="GOTÓWKA">Gotówka</option>
    </select>
  </label>

  <br /><br />

  <button type="submit">Zapisz zmiany</button>
</form>
<hr />

<!-- ================================================= -->
<!-- ================= DELETE ======================== -->
<!-- ================================================= -->

<h2>Usuń rezerwację</h2>

<label>
  Wybierz rezerwację:
  <select id="deleteReservationSelect">
    <option value="">---</option>
    <% reservations.forEach(r => { %>
    <option value="<%= r.id %>">
      <%= r.userName %> | <%= r.movieTitle %> | <%= new
      Date(r.startAt).toLocaleString() %>
    </option>
    <% }) %>
  </select>
</label>

<br /><br />

<button id="deleteReservationBtn">Usuń rezerwację</button>

<br />
<br />
<a href="/reservation/list">Lista rezerwacji</a>
<!-- ================================================= -->
<!-- ================= JS ============================ -->
<!-- ================================================= -->

<script>
  async function loadAvailableSeats(
    screeningId,
    selectEl,
    selectedSeatId = null
  ) {
    selectEl.innerHTML = "";
    selectEl.disabled = true;

    if (!screeningId) return;

    const res = await fetch(`/api/reservation/available-seats/${screeningId}`);
    if (!res.ok) {
      alert("Błąd pobierania miejsc");
      return;
    }

    const seats = await res.json();

    seats.forEach((s) => {
      const opt = document.createElement("option");
      opt.value = s._id;
      opt.textContent = `Rząd ${s.row} — Miejsce ${s.seat_number}`;
      if (selectedSeatId && String(s._id) === String(selectedSeatId)) {
        opt.selected = true;
      }
      selectEl.appendChild(opt);
    });

    selectEl.disabled = false;
  }

  /* ---------- CREATE ---------- */
  const createScreening = document.getElementById("screeningSelect");
  const createSeatSelect = document.getElementById("seatSelect");

  createScreening.addEventListener("change", (e) => {
    loadAvailableSeats(e.target.value, createSeatSelect);
  });

  document
    .getElementById("addReservationForm")
    .addEventListener("submit", async (e) => {
      e.preventDefault();
      const f = e.target;

      const seat_ids = [...createSeatSelect.selectedOptions].map(
        (o) => o.value
      );
      if (!seat_ids.length) return alert("Wybierz miejsce");

      const payload = {
        user_id: f.user_id.value,
        screening_id: f.screening_id.value,
        seat_ids,
        payment_provider: f.payment_provider.value,
        payment_status: f.payment_status.value,
      };

      const res = await fetch("/api/reservation/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      alert(res.ok ? "✅ Utworzono" : "❌ Błąd");
      if (res.ok) location.reload();
    });

  /* ---------- EDIT ---------- */
  const reservationSelect = document.getElementById("reservationSelect");
  const editForm = document.getElementById("editReservationForm");
  const editSeatSelect = document.getElementById("editSeatSelect");
  const editScreeningSelect = document.getElementById("editScreeningSelect");

  reservationSelect.addEventListener("change", async () => {
    if (!reservationSelect.value) return;

    const r = await fetch(
      `/api/reservation/show/${reservationSelect.value}`
    ).then((r) => r.json());

    editForm.reservation_id.value = r._id;
    editForm.user_id.value = r.user_id?._id ?? "";
    editScreeningSelect.value = r.screening_id?._id ?? "";
    editForm.payment_status.value = r.ticket_id?.payment_id?.status ?? "";
    editForm.payment_provider.value = r.ticket_id?.payment_id?.provider ?? "";

    loadAvailableSeats(r.screening_id._id, editSeatSelect, r.seats_id?._id);
  });

  editScreeningSelect.addEventListener("change", (e) => {
    loadAvailableSeats(e.target.value, editSeatSelect);
  });

  editForm.addEventListener("submit", async (e) => {
    e.preventDefault();
    const id = editForm.reservation_id.value;
    if (!id) return;

    const payload = {};
    [
      "user_id",
      "screening_id",
      "seats_id",
      "payment_status",
      "payment_provider",
    ].forEach((k) => editForm[k].value && (payload[k] = editForm[k].value));

    const res = await fetch(`/api/reservation/update/${id}`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify(payload),
    });

    alert(res.ok ? "✅ Zapisano" : "❌ Błąd");
    if (res.ok) location.reload();
  });

  /* ---------- DELETE ---------- */
  const deleteSelect = document.getElementById("deleteReservationSelect");
  const deleteBtn = document.getElementById("deleteReservationBtn");

  deleteBtn.addEventListener("click", async () => {
    const id = deleteSelect.value;
    if (!id) {
      alert("Wybierz rezerwację do usunięcia");
      return;
    }

    const res = await fetch(`/api/reservation/delete/${id}`, {
      method: "DELETE",
    });

    if (res.ok) {
      alert("🗑️ Rezerwacja usunięta");
      location.reload();
    } else {
      const err = await res.json().catch(() => ({}));
      alert(err.error || "❌ Błąd usuwania rezerwacji");
    }
  });
</script>
