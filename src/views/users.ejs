<h1>Zarządzaj Użytkownikami</h1>

<!-- ===================== -->
<!-- DODAJ USERA -->
<!-- ===================== -->
<section>
  <h2>Dodaj użytkownika</h2>

  <form id="addUserForm">
    <input name="name" placeholder="Imię..." required />
    <input name="surname" placeholder="Nazwisko..." />
    <input name="email" type="email" placeholder="Email..." required />
    <input name="password" type="password" placeholder="Hasło..." required />
    <button type="submit">Dodaj</button>
  </form>
</section>

<script>
  document
    .getElementById("addUserForm")
    .addEventListener("submit", async (e) => {
      e.preventDefault();

      const form = e.target;

      const res = await fetch("/api/users/create", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          name: form.name.value,
          surname: form.surname.value,
          email: form.email.value,
          password: form.password.value,
        }),
      });

      if (res.ok) {
        window.location.href = "/users/list";
      } else {
        const err = await res.json();
        alert(err.error || "Błąd dodawania użytkownika");
      }
    });
</script>

<hr />

<!-- ===================== -->
<!-- EDYTUJ USERA -->
<!-- ===================== -->
<section>
  <h2>Edytuj użytkownika</h2>

  <form id="editUserForm">
    <select id="editUserSelect">
      <option value="">--- wybierz użytkownika ---</option>

      <% users.forEach(u => { %>
      <option
        value="<%= u.id %>"
        data-name="<%= u.name %>"
        data-surname="<%= u.surname %>"
        data-email="<%= u.email %>"
      >
        <%= u.name %> <%= u.surname %> (<%= u.email %>)
      </option>
      <% }) %>
    </select>

    <br /><br />

    <input name="name" placeholder="Imię..." />
    <input name="surname" placeholder="Nazwisko..." />
    <input name="email" placeholder="Email..." />

    <button type="submit">Zaktualizuj</button>
  </form>
</section>

<script>
  const editUserSelect = document.getElementById("editUserSelect");
  const editUserForm = document.getElementById("editUserForm");

  editUserSelect.addEventListener("change", () => {
    const o = editUserSelect.options[editUserSelect.selectedIndex];
    editUserForm.name.value = o.dataset.name || "";
    editUserForm.surname.value = o.dataset.surname || "";
    editUserForm.email.value = o.dataset.email || "";
  });

  editUserForm.addEventListener("submit", async (e) => {
    e.preventDefault();

    const id = editUserSelect.value;

    const res = await fetch(`/api/users/update/${id}`, {
      method: "PATCH",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({
        name: editUserForm.name.value,
        surname: editUserForm.surname.value,
        email: editUserForm.email.value,
      }),
    });

    if (res.ok) {
      window.location.href = "/users/list";
    } else {
      const err = await res.json();
      alert(err.error || "Błąd edycji użytkownika");
    }
  });
</script>

<hr />

<!-- ===================== -->
<!-- USUŃ USERA -->
<!-- ===================== -->
<section>
  <h2>Usuń użytkownika</h2>

  <select id="deleteUserSelect">
    <% users.forEach(u => { %>
    <option value="<%= u.id %>">
      <%= u.name %> <%= u.surname %> (<%= u.email %>)
    </option>
    <% }) %>
  </select>

  <button id="deleteUserBtn">Usuń</button>
</section>

<script>
  document
    .getElementById("deleteUserBtn")
    .addEventListener("click", async () => {
      const id = document.getElementById("deleteUserSelect").value;

      const res = await fetch(`/api/users/delete/${id}`, {
        method: "DELETE",
      });

      if (res.ok) {
        window.location.href = "/users/list";
      } else {
        alert("Błąd usuwania użytkownika");
      }
    });
</script>

<br /><br />
<a href="/users/list">Lista użytkowników</a>
